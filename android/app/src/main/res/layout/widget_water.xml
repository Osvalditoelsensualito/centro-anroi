<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:id="@+id/widget_water_root"
    android:background="@drawable/widget_bg"
    android:orientation="vertical"
    android:padding="14dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="💧 Agua"
        android:textColor="#FFFFFF"
        android:textSize="13sp"
        android:textStyle="bold" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:orientation="horizontal"
        android:gravity="center_vertical">
        <TextView
            android:id="@+id/widget_water_glasses"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="0 / 8 vasos"
            android:textColor="#B8BEC8"
            android:textSize="12sp" />
        <TextView
            android:id="@+id/widget_water_plus"
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:background="@drawable/widget_habit_dot"
            android:gravity="center"
            android:text="＋"
            android:textColor="#0A0C0F"
            android:textStyle="bold"
            android:textSize="16sp" />
    </LinearLayout>

    <ProgressBar
        android:id="@+id/widget_water_progress"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="8dp"
        android:layout_marginTop="10dp"
        android:max="100"
        android:progress="0"
        android:progressDrawable="@drawable/widget_progress_water" />
</LinearLayout>
